# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://www.alexongroupltd.com
NEXT_PUBLIC_WHATSAPP_NUMBER=254701381197

# ---------- Supabase ----------
# URL and anon key are safe in the browser. The service role key is NOT —
# it bypasses row level security and is only read inside app/api routes.
NEXT_PUBLIC_SUPABASE_URL=https://evpmqawiegaifeobirin.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- M-Pesa (Safaricom Daraja) ----------
# From developer.safaricom.co.ke → your app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Your paybill or till number, and the passkey Safaricom issued for it
MPESA_SHORTCODE=
MPESA_PASSKEY=
# 'sandbox' while testing, 'production' after Safaricom approves go-live
MPESA_ENV=sandbox
# Public HTTPS origin Safaricom can reach. Use an ngrok URL locally,
# your Vercel domain in production. No trailing slash.
MPESA_CALLBACK_URL=https://your-app.vercel.app
